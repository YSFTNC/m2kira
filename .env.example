# Kopyalayıp .env olarak kaydedin. .env git'e girmez.

# Telegram (BotFather'dan token). CHAT_ID boş bırakılırsa bota ilk /start yazan sohbet kaydedilir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-posta (notify.channels içinde email varsa)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ntfy.sh (notify.channels içinde ntfy varsa)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# sahibinden "favori arama" e-postalarını okumak için IMAP (Gmail: 2 adımlı doğrulama + uygulama şifresi)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Sunucuda tarayıcı kaynaklarını kapatmak için (virgülle): hepsiemlak,emlakjet,sahibinden_mail
# M2KIRA_SOURCES=
