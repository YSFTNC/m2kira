# systemd birimi (VPS / Raspberry Pi, Docker'sız)
#   sudo cp deploy/m2kira.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now m2kira
#   journalctl -u m2kira -f
[Unit]
Description=m2kira - Ankara M2 eşyalı kiralık ilan takipçisi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/m2kira
Environment=TZ=Europe/Istanbul
Environment=M2KIRA_SOURCES=hepsiemlak,emlakjet,sahibinden_mail
ExecStart=/home/pi/m2kira/.venv/bin/python main.py run
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
